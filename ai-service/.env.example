# === LLM Mode ===
LLM_MODE=CLOUD_API           # CLOUD_API | HYBRID_SAFE | LOCAL_ONLY
ALLOW_CLOUD_LLM=true

# === Cloud API (Phase 1) — KHÔNG commit key thật ===
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENROUTER_API_KEY=

# === Local LLM (Phase 4) ===
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://ai-server:8000/v1

# === AI Gateway ===
AI_GATEWAY_HOST=0.0.0.0
AI_GATEWAY_PORT=8001
AI_GATEWAY_INTERNAL_KEY=

# === .NET API integration ===
DOTNET_API_BASE_URL=http://localhost:5000

# === Data ===
USE_MOCK_DATA=true            # true=Phase 1B (đọc mock_data.json), false=Phase 2A (gọi SP qua .NET API)

# === Rate Limiting (đối chiếu với .NET API) ===
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_HOUR=20
RATE_LIMIT_PER_DAY=50

# === Cache ===
CACHE_BACKEND=memory          # memory | redis
REDIS_URL=redis://localhost:6379

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json

# === Pipeline timeouts (giây) ===
TIMEOUT_INTENT_SECONDS=5
TIMEOUT_TOOL_SECONDS=15
TIMEOUT_ANSWER_SECONDS=20
TIMEOUT_PIPELINE_SECONDS=45

# === Qdrant (Phase 4) ===
QDRANT_URL=http://localhost:6333
