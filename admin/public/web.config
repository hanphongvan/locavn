<?xml version="1.0" encoding="utf-8"?>
<!--
  Bản tối thiểu: không dùng <rewrite> → không cần cài "IIS URL Rewrite" (tránh 500.19 / 500 khi thiếu module).

  Deep link Angular (F5 trên /login, …): cài URL Rewrite rồi đổi tên file
  `web.config.with-url-rewrite` → `web.config` (ghi đè) và deploy lại.

  Cảnh báo COOP trên Chrome với http://: bật HTTPS cho xangdau.tpg.vn hoặc gỡ header
  Cross-Origin-Opener-Policy ở IIS (Site → HTTP Response Headers).
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
