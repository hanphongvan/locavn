<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config nguồn để dotnet publish nhúng/transform cho IIS.
  Lý do tồn tại: gỡ WebDAVModule + handler WebDAV — nếu server IIS cài "WebDAV Publishing",
  module này chiếm PUT/DELETE và trả 405 trước khi request tới ASP.NET Core (vd PUT /api/my-vehicles/{id}).
  Phần <aspNetCore> do SDK tự cập nhật khi publish (processPath/arguments/hostingModel).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Httm.XangDau.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
